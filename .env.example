# ---------------------------------------------------------------------------
# SkillBridge LMS - Frontend environment variables
# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored. Never commit real secrets.
#   cp .env.example .env
#
# Every variable here is exposed to the browser bundle (VITE_ prefix).
# Nothing secret may ever be placed in this file.
# ---------------------------------------------------------------------------

# API base URL used by the browser.
# Default is the relative path "/api/v1", which the Vite dev server proxies to
# the backend (see vite.config.ts). Keeping it relative means development and
# production behave identically: production just needs a reverse proxy that
# forwards /api to the Node server.
VITE_API_BASE_URL=/api/v1

# Absolute backend URL. Set this to bypass the dev proxy and talk to the API
# directly, e.g. when CORS is configured on the backend for this origin.
# Example: http://localhost:5000/api/v1
VITE_API_DIRECT_URL=

# Port for `npm run dev`. Must match one of the origins in the backend's
# CORS_ORIGINS allow-list. strictPort is on, so Vite fails instead of
# silently choosing 5174.
VITE_DEV_PORT=5173

# Port used by `npm run preview` to serve the production build.
VITE_PREVIEW_PORT=4173

# Host interface the dev server binds to.
VITE_DEV_HOST=localhost

# Absolute URL of the backend, used only by the dev-server proxy target.
# This is a build-time value consumed by vite.config.ts, not by the app.
VITE_PROXY_TARGET=http://localhost:5000

# Displayed in the navbar and document title.
VITE_APP_NAME=SkillBridge LMS
